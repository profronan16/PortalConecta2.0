# Sem Supabase: o banco e um PostgreSQL proprio (VPS em producao, cluster local em dev)
# Database (PostgreSQL proprio â€” producao no VPS, dev em 127.0.0.1:5433)
DATABASE_URL="postgresql://usuario:senha@127.0.0.1:5432/portal_conecta?schema=public"
DIRECT_URL="postgresql://usuario:senha@127.0.0.1:5432/portal_conecta?schema=public"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-um-secret-seguro-com-openssl-rand-base64-32

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=seu-google-client-id
GOOGLE_CLIENT_SECRET=seu-google-client-secret

# Firebase Client (Autenticação)
NEXT_PUBLIC_FIREBASE_API_KEY=sua-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=seu-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=seu-firebase-app-id

# Firebase Admin SDK (opcional - usado para login SUAP)
FIREBASE_ADMIN_PROJECT_ID=seu-projeto
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Resend (Email)
RESEND_API_KEY=re_seu-api-key

# Cron Jobs (Vercel injeta o header Authorization: Bearer <CRON_SECRET> automaticamente)
CRON_SECRET=gere-um-secret-seguro-com-openssl-rand-hex-32

# Armazenamento local de arquivos (upload de PDF/imagens)
STORAGE_ROOT=/var/www/portal-files
STORAGE_PUBLIC_PREFIX=/files
