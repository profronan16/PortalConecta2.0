# ==============================================================================
# PORTAL CONECTA 2.0 — CONFIGURAÇÃO DE AMBIENTE (.env.local)
# ==============================================================================

# Sem Supabase: o banco e um PostgreSQL proprio (VPS em producao, cluster local em dev)
# Database (PostgreSQL proprio â€” producao no VPS, dev em 127.0.0.1:5433)
DATABASE_URL="postgresql://usuario:senha@127.0.0.1:5432/portal_conecta?schema=public"
DIRECT_URL="postgresql://usuario:senha@127.0.0.1:5432/portal_conecta?schema=public"

# NextAuth / Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-um-secret-seguro-com-openssl-rand-base64-32

# Master Admin (Bootstrap inicial)
ADMIN_EMAILS="ronan.lopes@ifpr.edu.br"
ALLOWED_PROFESSOR_DOMAIN="ifpr.edu.br"

# IA / RAG & Embeddings
# Anthropic Claude API (para geração de respostas da IFizinha e interpretação de documentos)
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (para geração de Embeddings — tier gratuito, sem custo)
# Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
EMBEDDING_MODEL=gemini-embedding-2

# Integração SUAP IFPR
SUAP_BASE_URL=https://suap.ifpr.edu.br
SUAP_CAMPUS_SIGLA=IVAIPODG
SUAP_API_TOKEN=cole-seu-token-pessoal-aqui
# SUAP_USERNAME=20251IVA10030013
# SUAP_PASSWORD=sua-senha-suap-aqui

# SUAP OAuth2 (recomendado — não expira em 24h como o SUAP_API_TOKEN manual)
# Cadastre em suap.ifpr.edu.br/api/oauth2/applications/ com
# "Authorization grant type: Client credentials" e "Client type: Confidential"
SUAP_CLIENT_ID=cole-o-client-id-aqui
SUAP_CLIENT_SECRET=cole-o-client-secret-aqui

# Google OAuth
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-google-client-secret

# CAPTCHA (Cloudflare Turnstile) — gratuito, chave em
# https://dash.cloudflare.com/?to=/:account/turnstile
# Sem essas duas variáveis, o CAPTCHA fica desligado (não bloqueia ninguém) —
# ver src/lib/turnstile.ts
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Armazenamento local de arquivos (upload de PDF/imagens)
STORAGE_ROOT=/var/www/portal-files
STORAGE_PUBLIC_PREFIX=/files
